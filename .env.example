NODE_ENV=development
PORT=3000

# Postgres corre en Docker (ver docker-compose.yml)
DB_HOST=localhost
DB_PORT=5435          # a propósito distinto del 5432 default (y del 5434, que ya
                       # usa otro proyecto local) para no chocar con nada más
DB_USER=cielos
DB_PASSWORD=cielos
DB_NAME=cielos_abiertos_alabanzas
# SSL hacia Postgres: false en local (el Postgres de Docker no tiene SSL), true en producción (Neon lo exige)
DB_SSL=false

# Cualquier string largo sirve en dev; en producción usar un secreto real
JWT_SECRET=change-me-in-production
# 8hs para cubrir un servicio/ensayo completo sin necesitar un endpoint de
# refresh (no existe todavía) — app interna de equipo, el riesgo de una
# sesión más larga es aceptable acá.
JWT_EXPIRES_IN=8h

# Storage tipo S3 (MinIO local via docker-compose) — audios de tracks y fotos de letras
# se suben directo del browser al bucket con URLs firmadas, el backend nunca ve el binario
# Puerto 9002 (no el 9000 default) porque otro proyecto local ya lo usa
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=cielos-abiertos-media
S3_ACCESS_KEY=cielos_minio
S3_SECRET_KEY=cielos_minio_secret
S3_FORCE_PATH_STYLE=true

# Consola de MinIO en http://localhost:9003 (mismas credenciales que arriba)

FRONTEND_URL=http://localhost:8080

# Redis para colas (bullmq) — reservado, todavía sin uso activo
# Puerto 6380 (no el 6379 default) porque otro proyecto local ya lo usa
QUEUE_REDIS_HOST=127.0.0.1
QUEUE_REDIS_PORT=6380
QUEUE_REDIS_PASSWORD=

# ─── Producción (Render + Neon + Cloudflare R2) ───────────────────────────────
# Estos valores se cargan en el panel de Environment de Render, NUNCA en este archivo
# ni en el repo. Referencia de qué va en cada una:
#   NODE_ENV=production
#   DB_HOST=<host de Neon SIN "-pooler" (conexión directa, recomendada para migraciones)>
#   DB_PORT=5432
#   DB_USER=<usuario de Neon>    DB_PASSWORD=<contraseña de Neon>    DB_NAME=<base de Neon>
#   DB_SSL=true
#   JWT_SECRET=<secreto largo al azar>
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   (sin el bucket al final)
#   S3_REGION=auto
#   S3_BUCKET=<bucket de R2>    S3_ACCESS_KEY=<Access Key ID de R2>    S3_SECRET_KEY=<Secret de R2>
#   S3_FORCE_PATH_STYLE=true
#   FRONTEND_URL=<URL del frontend en Vercel>
# PORT lo pone Render; QUEUE_REDIS_* no se usan todavía. Ver docs/estado-actual.md.
