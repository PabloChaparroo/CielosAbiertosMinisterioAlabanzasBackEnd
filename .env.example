NODE_ENV=development
PORT=3000

# Postgres corre en Docker (ver docker-compose.yml)
DB_HOST=localhost
DB_PORT=5435          # a propósito distinto del 5432 default (y del 5434, que ya
                       # usa otro proyecto local) para no chocar con nada más
DB_USER=cielos
DB_PASSWORD=cielos
DB_NAME=cielos_abiertos_alabanzas

# Cualquier string largo sirve en dev; en producción usar un secreto real
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m

# Storage tipo S3 (MinIO local via docker-compose) — audios de tracks y fotos de letras
# se suben directo del browser al bucket con URLs firmadas, el backend nunca ve el binario
# Puerto 9002 (no el 9000 default) porque otro proyecto local ya lo usa
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_BUCKET=cielos-abiertos-media
S3_ACCESS_KEY=cielos_minio
S3_SECRET_KEY=cielos_minio_secret
S3_FORCE_PATH_STYLE=true

# Consola de MinIO en http://localhost:9003 (mismas credenciales que arriba)

FRONTEND_URL=http://localhost:8080

# Redis para colas (bullmq) — reservado, todavía sin uso activo
# Puerto 6380 (no el 6379 default) porque otro proyecto local ya lo usa
QUEUE_REDIS_HOST=127.0.0.1
QUEUE_REDIS_PORT=6380
QUEUE_REDIS_PASSWORD=
