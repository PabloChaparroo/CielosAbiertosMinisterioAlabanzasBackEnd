{
  "name": "cielos-abiertos-alabanzas-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev-up.cjs",
    "build": "swc src -d dist --config-file .swcrc --copy-files --strip-leading-paths --ignore \"**/*.spec.ts\"",
    "build:watch": "swc src -d dist --config-file .swcrc --copy-files --strip-leading-paths --ignore \"**/*.spec.ts\" -w",
    "start:dev": "concurrently -k \"npm run build:watch\" \"node --watch dist/main.js\"",
    "start:prod": "node dist/main.js",
    "migration:generate": "npm run build && typeorm migration:generate -d dist/config/data-source.js",
    "migration:run": "npm run build && typeorm migration:run -d dist/config/data-source.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/config/data-source.js",
    "seed:run": "npm run build && node dist/database/seeds/run-seed.js",
    "admin:create": "npm run build && node dist/database/seeds/create-admin.js",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/terminus": "^12.0.0",
    "@nestjs/typeorm": "^12.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.4.3",
    "joi": "^17.13.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "typeorm-naming-strategies": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.10.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.16.5",
    "@types/passport-jwt": "^4.0.1",
    "chokidar": "^5.0.0",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.7",
    "oxfmt": "^0.1.0",
    "oxlint": "^0.15.0",
    "typescript": "^5.8.3",
    "vitest": "^5.0.1"
  },
  "overrides": {}
}
